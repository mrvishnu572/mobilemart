# Copy this file to .env and replace the placeholders with your own values.
# Never commit .env or use production secrets in source control.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/mobilemart
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Admin account used only by `npm run create:admin`. Use your own credentials.
# To promote an EXISTING account, first register it, then set ADMIN_EMAIL to its exact email.
# Keep ADMIN_REQUIRE_EXISTING_USER=true to prevent accidentally creating a separate account.
# Replace ALL sample values before running `npm run create:admin`.
ADMIN_REQUIRE_EXISTING_USER=true
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Optional Google sign-in and email delivery configuration.
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MobileMart <no-reply@mobilemart.com>

# Razorpay TEST MODE credentials (get these from your Razorpay Dashboard)
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# GST invoice settings. Confirm these with your GST registration before production.
GST_SELLER_STATE=Kerala
GST_SELLER_STATE_CODE=32
GSTIN=
GST_LEGAL_NAME=MobileMart
